# ─────────────────────────────────────────────────────────────
# Res Privata – zmienne środowiskowe
# Skopiuj ten plik jako .env.local i uzupełnij wartości.
# Nigdy nie commituj prawdziwych kluczy do repozytorium.
# ─────────────────────────────────────────────────────────────

# Publiczny adres strony (bez ukośnika na końcu). Lokalnie: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (etap 2) – baza danych, logowanie, pliki. Region: UE (Frankfurt).
# Adres projektu: Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Klucz publiczny (anon/publishable) – bezpieczny w przeglądarce, chroniony przez RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Klucz serwisowy (service_role/secret) – TYLKO serwer, omija RLS. Nigdy nie udostępniaj.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (etap 3) – płatności i subskrypcje
# Klucz tajny: Stripe → Developers → API keys (sk_test_... w trybie testowym)
STRIPE_SECRET_KEY=
# Sekret webhooka: Stripe → Developers → Webhooks → Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=

# ── Resend (etap 2) – wysyłka e-maili
RESEND_API_KEY=
# Nadawca, np. "Res Privata <klub@twojadomena.pl>" (domena musi być zweryfikowana w Resend)
EMAIL_FROM=
# Adres, na który trafiają powiadomienia dla administratora
ADMIN_NOTIFY_EMAIL=

# ── Anthropic (etap 5) – szkice memo i raportów. Używane wyłącznie po stronie serwera.
ANTHROPIC_API_KEY=
# Model Claude (domyślnie claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-sonnet-5-5
